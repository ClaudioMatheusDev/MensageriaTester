{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/produtos",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "produto-service",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/produtos",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    },
    {
      "DownstreamPathTemplate": "/api/carrinho/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "carrinho-service",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/carrinho/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://api-gateway"
  }
}